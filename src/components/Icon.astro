---
/** Íconos de trazo, decorativos (aria-hidden). El texto accesible va en el botón. */
type Name = 'arrow' | 'down' | 'mail' | 'whatsapp' | 'download' | 'images' | 'close' | 'prev' | 'next' | 'menu' | 'expand' | 'play';
interface Props {
  name: Name;
  class?: string;
}
const { name, class: className } = Astro.props;
const paths: Record<Name, string> = {
  arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
  down: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 7 8.5-7"/>',
  whatsapp:
    '<path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"/><path d="M9.2 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5.6 1 1.4 1.8 2.4 2.3.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5v.4c0 .4-.2.8-.6 1-.6.3-1.4.4-2.2.1a8.4 8.4 0 0 1-4.6-4.4c-.4-.9-.3-1.9-.5-2.6z"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  images: '<rect x="3" y="5" width="14" height="12" rx="1.5"/><path d="M7 21h12a2 2 0 0 0 2-2V9"/><path d="m3 14 4-4 4 4 2-2 4 4"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  prev: '<path d="M15 5l-7 7 7 7"/>',
  next: '<path d="M9 5l7 7-7 7"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  expand: '<path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/>',
  play: '<path d="M8 5v14l11-7z"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
