---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { getProjectImages, pickCover } from '../lib/assets';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const index = projects.map((p) => ({ project: p, cover: pickCover(getProjectImages(p.slug)) }));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="hero__by ui">
      <strong>{site.name}</strong>
      <span>{t.hero.kicker}</span>
    </p>

    <h1 id="hero-title">
      <span>{t.hero.titleLead}</span>
      <span>{t.hero.titleAccent}</span>
      {t.hero.titleTail && <span>{t.hero.titleTail}</span>}
    </h1>

    <div class="hero__foot">
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href="#proyectos">
          {t.hero.ctaProjects}
          <Icon name="down" />
        </a>
        {
          site.sections.contact && (
            <a class="btn" href="#contacto">
              {t.hero.ctaContact}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <nav class="wrap plan" aria-labelledby="plan-title">
    <h2 id="plan-title" class="plan__title ui">
      {t.hero.indexTitle}
      <span class="plan__count">{projects.length}</span>
      <span class="visually-hidden">({t.a11y.projectIndex})</span>
    </h2>
    <ol class="plan__list">
      {
        index.map(({ project: p, cover }, i) => (
          <li style={`--i:${i}`}>
            <a href={`#p-${p.slug}`} class="tile">
              <span class="tile__img">
                {cover && (
                  <img
                    src={cover.thumb}
                    width={cover.thumbWidth}
                    height={cover.thumbHeight}
                    alt=""
                    decoding="async"
                    fetchpriority={i < 4 ? 'high' : 'auto'}
                  />
                )}
              </span>
              <span class="tile__title ui">{p.text[locale].title}</span>
              <span class:list={['tile__kind', 'ui', `tile__kind--${p.kind}`]}>
                {p.kind === 'live' ? t.hero.indexLive : t.hero.indexScreens}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .hero {
    padding-block: clamp(1.75rem, 4.5vw, 3.75rem) 0;
  }

  .hero__by {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.98rem;
    color: var(--muted);
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }

  .hero__by strong {
    color: var(--bone);
    font-weight: 650;
  }

  .hero__by span {
    position: relative;
  }

  .hero__by span::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 50%;
    width: 0.4rem;
    height: 1px;
    background: var(--line-strong);
  }

  h1 {
    display: grid;
    font-size: clamp(2.45rem, 0.9rem + 5.4vw, 6rem);
    font-weight: 660;
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  /* Cada renglón se ilumina por turno, como una sala que enciende sus focos. */
  h1 span {
    animation: light-up 1.1s var(--ease-out) both;
  }

  h1 span:nth-child(2) {
    animation-delay: 0.12s;
  }

  h1 span:nth-child(3) {
    animation-delay: 0.24s;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.75rem 3rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__lead {
    max-width: 54ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--bone-dim);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* --- Plano de sala: índice visual de proyectos ------------------------- */

  .plan {
    margin-top: clamp(2.75rem, 5vw, 4rem);
  }

  .plan__title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--bone-dim);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .plan__count {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .plan__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: clamp(1rem, 2vw, 1.75rem) clamp(1rem, 2vw, 1.5rem);
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.55rem 0.75rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .tile__img {
    grid-column: 1 / -1;
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--wall-2);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  .tile__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    animation: lamp 1.4s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i) * 0.09s);
    transition:
      scale 0.5s var(--ease-out),
      filter 0.3s;
  }

  .tile:hover .tile__img img,
  .tile:focus-visible .tile__img img {
    scale: 1.04;
  }

  .tile__title {
    font-size: 0.98rem;
    font-weight: 550;
    line-height: 1.3;
    color: var(--bone);
    text-wrap: balance;
  }

  .tile:hover .tile__title {
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-underline-offset: 0.2em;
  }

  .tile__kind {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.1rem;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .tile__kind::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 1px;
  }

  .tile__kind--live {
    color: var(--marigold);
  }

  .tile__kind--live::before {
    border-radius: 50%;
    background: currentColor;
  }

  @keyframes light-up {
    from {
      opacity: 0;
      color: var(--wall-3);
    }
  }

  @keyframes lamp {
    from {
      opacity: 0.25;
      filter: brightness(0.35) saturate(0.4);
    }
  }

  @media (max-width: 560px) {
    .hero__by {
      flex-direction: column;
    }

    .hero__by span::before {
      display: none;
    }

    .plan__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile__title {
      font-size: 0.9rem;
    }

    .tile__kind {
      font-size: 0.76rem;
    }
  }
</style>
