---
import { useTranslations, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="sobre-mi" class="section" aria-labelledby="sobre-mi-title">
  <div class="wrap about">
    <header class="section-head about__head">
      <h2 id="sobre-mi-title">{t.about.title}</h2>
    </header>

    <div class="about__bio">
      {site.bio[locale].map((paragraph, i) => <p class:list={{ lead: i === 0 }}>{paragraph}</p>)}
    </div>

    <div class="about__how">
      <h3 class="ui">{t.about.howTitle}</h3>
      <ol>
        {
          t.about.how.map((step, i) => (
            <li>
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <div>
                <p class="step__title">{step.title}</p>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    column-gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .about__head {
    grid-column: 1 / -1;
  }

  .about__bio {
    display: grid;
    gap: 1.25rem;
    color: var(--bone-dim);
    font-size: 1.08rem;
  }

  .about__bio .lead {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.25;
    color: var(--bone);
    margin-bottom: 0.5rem;
  }

  .about__how {
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--wall-1);
  }

  .about__how h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--light) / 0.45);
    color: var(--marigold);
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .step__title {
    font-weight: 600;
    font-size: 1.08rem;
  }

  .step__text {
    color: var(--muted);
    margin-top: 0.25rem;
    font-size: 0.98rem;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
    }
  }
</style>
