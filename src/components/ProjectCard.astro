---
import Icon from './Icon.astro';
import { useTranslations, fmt, type Locale } from '../i18n';
import type { Project } from '../data/projects';
import { getProjectImages, pickCover } from '../lib/assets';

interface Props {
  project: Project;
  index: number;
  locale: Locale;
}

/*
 * Cada proyecto se presenta como una obra en sala: la captura principal bajo
 * un foco de luz y, a su lado, la cédula con el título, para qué sirve y la
 * acción principal («Ver demo» o «Ver capturas»).
 */
const { project, locale } = Astro.props;
const t = useTranslations(locale);
const text = project.text[locale];
const images = getProjectImages(project.slug);
const cover = pickCover(images);
const coverIndex = cover ? images.indexOf(cover) : 0;
const isLive = project.kind === 'live' && !!project.demoUrl;
const MAX_THUMBS = 5;
const thumbs = images.slice(0, MAX_THUMBS);
const extra = images.length - thumbs.length;
const countLabel = images.length === 1 ? t.projects.screensCountOne : fmt(t.projects.screensCount, { n: images.length });
const galleryData = images.map((img) => ({
  src: img.webp,
  full: img.png,
  w: img.width,
  h: img.height,
  caption: img.caption,
}));
const coverSrcset = cover ? `${cover.thumb} ${cover.thumbWidth}w, ${cover.webp} ${cover.width}w` : '';
const coverSizes = '(max-width: 900px) 92vw, 860px';
---

<article
  id={`p-${project.slug}`}
  class:list={['exhibit', `exhibit--${project.kind}`]}
  aria-labelledby={`t-${project.slug}`}
>
  <div class="exhibit__grid">
    <div class="exhibit__media">
      {
        isLive ? (
          <a class="frame" href={project.demoUrl} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            {cover ? (
              <img
                class="frame__img"
                src={cover.webp}
                srcset={coverSrcset}
                sizes={coverSizes}
                width={cover.width}
                height={cover.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="placeholder ui">{t.projects.placeholderLabel}</span>
            )}
            <span class="frame__hint ui">
              {t.projects.viewDemo}
              <Icon name="arrow" />
            </span>
          </a>
        ) : cover ? (
          <button class="frame" type="button" data-lightbox-open={project.slug} data-index={coverIndex}>
            <img
              class="frame__img"
              src={cover.webp}
              srcset={coverSrcset}
              sizes={coverSizes}
              width={cover.width}
              height={cover.height}
              alt={fmt(t.projects.previewAlt, { title: text.title })}
              loading="lazy"
              decoding="async"
            />
            <span class="frame__hint ui" aria-hidden="true">
              <Icon name="expand" />
              {text.galleryButton ?? t.projects.viewScreens}
            </span>
            <span class="visually-hidden">
              {fmt(t.projects.openImage, { n: coverIndex + 1, total: images.length, caption: cover.caption })}
            </span>
          </button>
        ) : (
          <div class="frame">
            <span class="placeholder ui">{t.projects.placeholderLabel}</span>
          </div>
        )
      }
    </div>

    {
      images.length > 1 && (
        <ul class="thumbs">
          {thumbs.map((img, i) => (
            <li>
              <button type="button" class="thumb" data-lightbox-open={project.slug} data-index={i}>
                <img src={img.thumb} width={img.thumbWidth} height={img.thumbHeight} alt="" loading="lazy" decoding="async" />
                {i === thumbs.length - 1 && extra > 0 && (
                  <span class="thumb__more ui" aria-hidden="true">
                    +{extra}
                  </span>
                )}
                <span class="visually-hidden">
                  {fmt(t.projects.openImage, { n: i + 1, total: images.length, caption: img.caption })}
                </span>
              </button>
            </li>
          ))}
        </ul>
      )
    }

    <div class="label">
      <p class:list={['label__kind', 'ui', `label__kind--${project.kind}`]}>
        <span>{isLive ? t.projects.kindLive : t.projects.kindScreens}</span>
        {images.length > 0 && <span class="label__count">{text.galleryCount ?? countLabel}</span>}
      </p>
      <h3 id={`t-${project.slug}`}>{text.title}</h3>
      {text.note && <p class="label__note ui">{text.note}</p>}
      <p class="label__desc">{text.description}</p>

      <div class="label__tech">
        <p class="label__tech-title ui">{t.projects.tagsLabel}</p>
        <ul class="tags">
          {project.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </div>

      <div class="label__actions">
        {
          isLive && (
            <a class="btn btn--light btn--demo" href={project.demoUrl} target="_blank" rel="noopener">
              {t.projects.viewDemo}
              <span class="visually-hidden">{t.a11y.opensInNewTab}</span>
              <Icon name="arrow" class="arrow" />
            </a>
          )
        }
        {
          images.length > 0 && (
            <button
              class:list={['btn', { 'btn--gallery': !isLive }]}
              type="button"
              data-lightbox-open={project.slug}
              data-index="0"
            >
              <Icon name="images" />
              {text.galleryButton ?? t.projects.viewScreens}
            </button>
          )
        }
        {
          project.videoSoon && (
            <span class="soon ui">
              <Icon name="play" />
              {t.projects.videoSoon}
            </span>
          )
        }
      </div>
    </div>
  </div>

  {images.length > 0 && <script type="application/json" data-gallery={project.slug} set:html={JSON.stringify(galleryData)} />}
</article>

<style>
  .exhibit {
    container-type: inline-size;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .exhibit__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* --- La obra: captura bajo un foco ------------------------------------ */

  .exhibit__media {
    position: relative;
    isolation: isolate;
  }

  /* Cono de luz cálida que cae sobre la captura. */
  .exhibit__media::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -14px -10% 30%;
    background: radial-gradient(ellipse 50% 70% at 50% 0%, rgb(var(--light) / 0.2), rgb(var(--light) / 0.05) 55%, transparent 75%);
    pointer-events: none;
  }

  /* La lámpara de galería, encima del marco. */
  .exhibit__media::after {
    content: '';
    position: absolute;
    top: -14px;
    left: 50%;
    width: 72px;
    height: 5px;
    translate: -50% 0;
    border-radius: 0 0 6px 6px;
    background: var(--wall-3);
    box-shadow:
      0 3px 0 -1px rgb(var(--light) / 0.85),
      0 6px 22px 2px rgb(var(--light) / 0.35);
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(6px, 1.2cqi, 12px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--wall-1);
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.85);
    cursor: pointer;
  }

  div.frame {
    cursor: default;
  }

  .frame__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    background: var(--wall-2);
    border-radius: 1px;
  }

  .frame__hint {
    position: absolute;
    right: clamp(14px, 2cqi, 24px);
    bottom: clamp(14px, 2cqi, 24px);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--wall) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--bone);
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.25s,
      translate 0.3s var(--ease-out);
  }

  .frame__hint :global(svg) {
    width: 1em;
    height: 1em;
  }

  .frame:hover .frame__hint,
  .frame:focus-visible .frame__hint {
    opacity: 1;
    translate: none;
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: repeating-linear-gradient(-45deg, transparent 0 11px, rgb(255 255 255 / 0.03) 11px 12px), var(--wall-2);
    color: var(--muted);
  }

  /* --- Miniaturas ------------------------------------------------------- */

  .thumbs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.4rem, 1cqi, 0.75rem);
    margin: clamp(0.5rem, 1.2cqi, 0.9rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--wall-2);
    cursor: zoom-in;
    transition: border-color 0.2s;
  }

  .thumb:hover {
    border-color: var(--marigold);
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    filter: brightness(0.78);
    transition: filter 0.25s;
  }

  .thumb:hover img,
  .thumb:focus-visible img {
    filter: none;
  }

  .thumb__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--wall) 70%, transparent);
    color: var(--bone);
    font-weight: 650;
  }

  /* --- La cédula ---------------------------------------------------------- */

  .label {
    position: relative;
    z-index: 1;
    margin: clamp(0.75rem, 2cqi, 1.25rem) 0 0;
    padding: clamp(1.4rem, 4cqi, 2.1rem);
    border-radius: var(--radius-panel);
    border-top: 3px solid var(--line-strong);
    background: var(--wall-2);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.9);
  }

  .exhibit--live .label {
    border-top-color: var(--marigold);
  }

  .label__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
    margin-bottom: 0.9rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--bone-dim);
  }

  .label__kind > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .label__kind > span:first-child::before {
    content: '';
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 1px;
  }

  .label__kind--live > span:first-child {
    color: var(--marigold);
  }

  .label__kind--live > span:first-child::before {
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px rgb(var(--light) / 0.8);
  }

  .label__count {
    color: var(--muted);
    font-weight: 500;
  }

  h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
    font-stretch: 112%;
    line-height: 1.04;
  }

  .label__note {
    display: inline-block;
    margin-top: 0.85rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--bone-dim);
    font-size: 0.8rem;
  }

  .label__desc {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--bone-dim);
    font-size: 1.07rem;
    line-height: 1.6;
  }

  .label__tech {
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .label__tech-title {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }

  .label__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }

  .btn--demo {
    min-height: 54px;
    padding-inline: 1.6rem;
    font-size: 1.08rem;
  }

  .btn--gallery {
    --btn-bd: var(--marigold);
    min-height: 54px;
    padding-inline: 1.4rem;
    font-size: 1.05rem;
  }

  .btn--gallery:hover {
    --btn-bd: var(--marigold-soft);
  }

  .soon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0 0.85rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .soon :global(svg) {
    width: 12px;
    height: 12px;
    color: var(--marigold);
  }

  /* --- Composición en pantallas anchas ----------------------------------- */

  @container (min-width: 880px) {
    .exhibit__grid {
      grid-template-columns: minmax(0, 1fr) minmax(19rem, 26rem);
      align-items: end;
    }

    .exhibit__media {
      grid-column: 1;
      grid-row: 1;
    }

    .thumbs {
      grid-column: 1;
      grid-row: 2;
    }

    /* La cédula se monta sobre el borde del marco, como una ficha en el muro. */
    .label {
      grid-column: 2;
      grid-row: 1;
      margin: 0 0 clamp(1.5rem, 4cqi, 3rem) -2rem;
    }
  }

  /* --- Encender la luz al llegar a cada obra (CSS, sin JS) ---------------- */

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .frame__img {
        animation: lamp-on linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }

      .exhibit__media::before {
        animation: glow-on linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes lamp-on {
    from {
      filter: brightness(0.3) saturate(0.5);
    }
    to {
      filter: none;
    }
  }

  @keyframes glow-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
