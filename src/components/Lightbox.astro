---
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog class="lightbox" aria-label={t.lightbox.label} data-lightbox data-counter={t.lightbox.counter}>
  <div class="lightbox__top">
    <p class="ui lightbox__counter" aria-live="polite" data-lb-counter></p>
    <p class="lightbox__hint">{t.lightbox.hint}</p>
    <button class="lb-btn" type="button" data-lb-close>
      <Icon name="close" />
      <span class="visually-hidden">{t.lightbox.close}</span>
    </button>
  </div>
  <figure class="lightbox__figure">
    <img data-lb-img alt="" />
    <figcaption data-lb-caption></figcaption>
  </figure>
  <button class="lb-btn lb-nav lb-nav--prev" type="button" data-lb-prev>
    <Icon name="prev" />
    <span class="visually-hidden">{t.lightbox.prev}</span>
  </button>
  <button class="lb-btn lb-nav lb-nav--next" type="button" data-lb-next>
    <Icon name="next" />
    <span class="visually-hidden">{t.lightbox.next}</span>
  </button>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 0;
    background: color-mix(in oklab, var(--wall) 95%, black);
    color: var(--bone);
    display: none;
    grid-template-rows: auto 1fr;
    gap: 0.75rem;
  }

  .lightbox[open] {
    display: grid;
    animation: fade 0.25s var(--ease-out);
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
  }

  .lightbox__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lightbox__counter {
    color: var(--marigold);
    margin: 0;
  }

  .lightbox__hint {
    flex: 1;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .lightbox__figure {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto;
    align-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding-inline: clamp(0rem, 5vw, 4.5rem);
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    height: auto;
    min-height: 0;
    object-fit: contain;
    align-self: center;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.9);
  }

  figcaption {
    max-width: 60ch;
    font-size: 1.05rem;
    color: var(--bone-dim);
    text-align: center;
  }

  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--wall-1);
    color: var(--bone);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .lb-btn:hover {
    border-color: var(--marigold);
    background: var(--wall-2);
  }

  .lb-btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  .lb-nav {
    position: fixed;
    top: 50%;
    translate: 0 -50%;
  }

  .lb-nav--prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lb-nav--next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  .lb-nav[hidden] {
    display: none;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .lightbox__hint {
      display: none;
    }
    .lightbox__top {
      justify-content: space-between;
    }
    .lb-nav {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
    .lightbox__figure {
      padding-bottom: 4.5rem;
    }
  }
</style>

<script>
  type Item = { src: string; full: string; w: number; h: number; caption: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!;
    const counterTpl = dialog.dataset.counter ?? '{n} / {total}';

    let items: Item[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const cache = new Map<string, Item[]>();
    const getItems = (slug: string): Item[] => {
      if (!cache.has(slug)) {
        const node = document.querySelector(`script[data-gallery="${CSS.escape(slug)}"]`);
        cache.set(slug, node?.textContent ? (JSON.parse(node.textContent) as Item[]) : []);
      }
      return cache.get(slug)!;
    };

    const render = () => {
      const item = items[index];
      if (!item) return;
      img.src = item.src;
      img.width = item.w;
      img.height = item.h;
      img.alt = item.caption;
      caption.textContent = item.caption;
      counter.textContent = counterTpl.replace('{n}', String(index + 1)).replace('{total}', String(items.length));
      const multiple = items.length > 1;
      prev.hidden = !multiple;
      next.hidden = !multiple;
      // Precarga la siguiente imagen.
      const upcoming = items[(index + 1) % items.length];
      if (upcoming) new Image().src = upcoming.src;
    };

    const go = (delta: number) => {
      if (items.length < 2) return;
      index = (index + delta + items.length) % items.length;
      render();
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox-open]');
      if (!trigger) return;
      items = getItems(trigger.dataset.lightboxOpen ?? '');
      if (!items.length) return;
      index = Math.min(Number(trigger.dataset.index ?? 0), items.length - 1);
      opener = trigger;
      render();
      dialog.showModal();
      close.focus();
      document.documentElement.style.overflow = 'hidden';
    });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    close.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      }
    });

    // Clic fuera de la imagen (sobre el fondo) cierra la galería.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Esc lo maneja <dialog> de forma nativa; al cerrar, el foco vuelve al disparador.
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });
  }
</script>
