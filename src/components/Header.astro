---
import Icon from './Icon.astro';
import { useTranslations, enabledLocales, localeTags, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Las secciones ocultas (site.sections) desaparecen del menú.
const links = [
  { href: '#proyectos', label: t.nav.projects, show: true },
  { href: '#sobre-mi', label: t.nav.about, show: site.sections.about },
  { href: '#tecnologias', label: t.nav.skills, show: true },
].filter((link) => link.show);
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand ui" href={`/${locale}/`}>
      <img src="/favicon.svg" alt="" width="34" height="34" />
      <span>{site.name}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-open-label={t.a11y.openMenu}
      data-close-label={t.a11y.closeMenu}
    >
      <Icon name="menu" />
      <span class="visually-hidden" data-menu-label>{t.a11y.openMenu}</span>
    </button>

    <nav id="site-nav" class="nav ui" aria-label={t.a11y.mainNav}>
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      {
        enabledLocales.length > 1 && (
          <ul class="langs" aria-label={t.a11y.languageSwitcher}>
            {enabledLocales.map((l) => (
              <li>
                <a
                  href={`/${l}/`}
                  hreflang={localeTags[l].htmlLang}
                  lang={localeTags[l].htmlLang}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  {localeTags[l].label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        site.sections.contact && (
          <a class="btn btn--light btn--small" href="#contacto">
            {t.nav.contact}
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  .site-header.is-scrolled {
    background: color-mix(in oklab, var(--wall) 84%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-weight: 650;
    font-stretch: 112%;
    font-size: 1.02rem;
  }

  .brand img {
    width: 34px;
    height: 34px;
  }

  .nav,
  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav ul a {
    position: relative;
    display: inline-block;
    padding-block: 0.45rem;
    text-decoration: none;
    color: var(--bone-dim);
    font-weight: 500;
    font-size: 0.98rem;
    transition: color 0.2s;
  }

  .nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--marigold);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.3s var(--ease-out);
  }

  .nav ul a:hover {
    color: var(--bone);
  }

  .nav ul a:hover::after,
  .langs a[aria-current='true']::after {
    scale: 1 1;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 640px) {
    .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--wall-1);
      color: var(--bone);
      cursor: pointer;
    }

    .menu-toggle :global(svg) {
      width: 20px;
      height: 20px;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 0.5rem var(--gutter) 2rem;
      background: var(--wall);
      border-bottom: 1px solid var(--line);
      visibility: hidden;
      opacity: 0;
      translate: 0 -8px;
      transition:
        opacity 0.25s,
        translate 0.25s var(--ease-out),
        visibility 0s 0.25s;
    }

    .nav.is-open {
      visibility: visible;
      opacity: 1;
      translate: none;
      transition:
        opacity 0.25s,
        translate 0.25s var(--ease-out);
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav ul a {
      display: block;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.5rem;
      font-weight: 640;
      font-stretch: 118%;
      color: var(--bone);
    }

    .nav ul a::after {
      display: none;
    }

    .site-header:has(.nav.is-open) {
      background: var(--wall);
      border-bottom-color: var(--line);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    if (label) label.textContent = (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
