---
import Icon from './Icon.astro';
import { useTranslations, enabledLocales, localeTags, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
  { href: '#proyectos', label: t.nav.projects },
  { href: '#sobre-mi', label: t.nav.about },
  { href: '#tecnologias', label: t.nav.skills },
];
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={`/${locale}/`}>
      <img src="/favicon.svg" alt="" width="34" height="34" />
      <span class="brand__name">{site.name}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-open-label={t.a11y.openMenu}
      data-close-label={t.a11y.closeMenu}
    >
      <Icon name="menu" />
      <span class="visually-hidden" data-menu-label>{t.a11y.openMenu}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t.a11y.mainNav}>
      <ul>
        {
          links.map((link, i) => (
            <li>
              <a href={link.href}>
                <span class="mono nav__num" aria-hidden="true">
                  0{i + 1}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        enabledLocales.length > 1 && (
          <ul class="langs" aria-label={t.a11y.languageSwitcher}>
            {enabledLocales.map((l) => (
              <li>
                <a
                  class="mono"
                  href={`/${l}/`}
                  hreflang={localeTags[l].htmlLang}
                  lang={localeTags[l].htmlLang}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  {l}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a class="btn btn--primary btn--small nav__cta" href="#contacto">{t.nav.contact}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  .site-header.is-scrolled {
    background: rgb(11 12 14 / 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand img {
    width: 34px;
    height: 34px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a:not(.btn) {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding-block: 0.4rem;
    text-decoration: none;
    color: var(--paper-dim);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav a:not(.btn):hover {
    color: var(--paper);
  }

  .nav__num {
    font-size: 0.6rem;
    color: var(--accent);
  }

  .langs a[aria-current='true'] {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      background: var(--ink-1);
      color: var(--paper);
      cursor: pointer;
    }

    .menu-toggle :global(svg) {
      width: 20px;
      height: 20px;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--ink-0);
      border-bottom: 1px solid var(--line);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s,
        transform 0.25s var(--ease-out),
        visibility 0s 0.25s;
    }

    .nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.25s,
        transform 0.25s var(--ease-out);
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav a:not(.btn) {
      display: flex;
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--line);
      font-size: 1.35rem;
      font-family: var(--font-display);
      color: var(--paper);
    }

    .site-header:has(.nav.is-open) {
      background: var(--ink-0);
      border-bottom-color: var(--line);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    if (label) label.textContent = (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
