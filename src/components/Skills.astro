---
import { useTranslations, type Locale } from '../i18n';
import { skills, skillGroups, type Skill } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const groups = (Object.keys(skillGroups) as Skill['group'][]).map((key) => ({
  key,
  label: skillGroups[key][locale],
  items: skills.filter((s) => s.group === key),
}));
---

<section id="tecnologias" class="section" aria-labelledby="tecnologias-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="tecnologias-title">{t.skills.title}</h2>
    </header>

    <div class="groups">
      {
        groups.map((group) => (
          <section class="group" aria-labelledby={`g-${group.key}`}>
            <h3 id={`g-${group.key}`} class="group__title ui">
              {group.label}
            </h3>
            <dl>
              {group.items.map((skill) => (
                <div class="skill">
                  <dt>{skill.name}</dt>
                  <dd>{skill.what[locale]}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(2.25rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .group__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
    color: var(--marigold);
    margin-bottom: 1.4rem;
  }

  .group__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  dl {
    margin: 0;
    display: grid;
    gap: 1.3rem;
  }

  .skill {
    display: grid;
    gap: 0.25rem;
  }

  dt {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 620;
    font-size: 1.35rem;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  dd {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.5;
  }
</style>
