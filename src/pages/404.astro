---
import Base from '../layouts/Base.astro';
import { defaultLocale, useTranslations } from '../i18n';

const t = useTranslations(defaultLocale);
---

<Base locale={defaultLocale} title={`${t.notFound.title} · ${t.meta.title}`} noindex>
  <section class="nf wrap">
    <p class="mono eyebrow">404</p>
    <h1>{t.notFound.title}</h1>
    <p>{t.notFound.text}</p>
    <a class="btn btn--primary" href={`/${defaultLocale}/`}>{t.notFound.back}</a>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
  }
  h1 {
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
  }
  p:not(.eyebrow) {
    color: var(--paper-dim);
  }
</style>
