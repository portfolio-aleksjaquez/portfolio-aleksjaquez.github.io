---
// Fuentes variables autoalojadas (font-display: swap; subconjuntos por unicode-range).
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/opsz.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import '../styles/global.css';

import { localeTags, enabledLocales, defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale = defaultLocale, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const tags = localeTags[locale];
---

<!doctype html>
<html lang={tags.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#10142b" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      enabledLocales.length > 1 &&
        enabledLocales.map((l) => (
          <link rel="alternate" hreflang={localeTags[l].htmlLang} href={new URL(`/${l}/`, Astro.site)} />
        ))
    }

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={tags.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.a11y.skipToContent}</a>
    <slot name="header" />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
